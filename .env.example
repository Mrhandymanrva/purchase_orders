# Local sample mode is in-memory and disabled automatically in production.
DEMO_MODE=true
APP_ORIGIN=http://127.0.0.1:3000
APP_USER=richmond-operator
APP_PASSWORD=
DATABASE_URL=postgresql://richmond:local-development-only@127.0.0.1:5432/richmond
PGSSL=false
# Integration defaults are sandbox/integration, never production.
ST_ENV=integration
ST_TENANT_ID=
ST_CLIENT_ID=
ST_CLIENT_SECRET=
ST_APP_KEY=
ST_BUSINESS_UNIT_IDS=
QBO_ENV=sandbox
QBO_REALM_ID=
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REFRESH_TOKEN=
QBO_CARD_ACCOUNT_IDS=
# Parent account ID for mapping protection. List only CHILD subaccount IDs above.
QBO_PARENT_CC_ACCOUNT_ID=
# 32 random bytes encoded as base64; keep stable and back up securely.
TOKEN_ENCRYPTION_KEY=
SYNC_FROM=2026-09-01

# Map only individually issued card account IDs, never a shared parent account.
QBO_CARDHOLDERS_JSON={}
# Optional exact QuickBooks Purchase CustomField name with actual card-user identity.
QBO_CARDHOLDER_FIELD=
